<main class="relative flex-1 px-6 py-4 md:px-8 bg-fridge bg-cover md:min-h-screen">

  <div class="inset-x-0 flex justify-center z-10">
    <div class="max-w-xl w-full rounded-2xl px-4 py-3 bg-white/80 backdrop-blur shadow-lg">
      <p class="text-center text-xl md:text-2xl font-bold text-gray-800">
        <%= @character.character.description %>
      </p>
      <p class="text-center text-sm text-gray-600 mt-1">
        <%= @character.consecutive_days %>
        <%= t('.no_discarded_days') %>
      </p>
    </div>
  </div>

  <div class="inset-0 flex flex-col items-center">
    <div class="absolute top-[55%] sm:top-[56%] md:top-[57%] left-1/2 -translate-x-1/2 -translate-y-[60%]">
      <%= image_tag @character.character.image,
      class: [
          # 親のmax-width制限を無効化
          "block max-w-none",
          # スマホ画面
          "w-[min(95vw,400px)] h-auto",
          # 縦の上限を設定
          "max-h-[70vh]",
          # 小〜大画面
          "sm:w-[min(80vw,500px)] md:w-[min(80vw,600px)] lg:w-[700px]"
        ].join(" ") %>
    </div>

    <div class="absolute bottom-20 sm:bottom-12 flex flex-row items-center justify-center gap-6">

      <%= link_to t('.discard'), new_food_actions_discard_path,
          class: "py-4 px-8 sm:px-16 mr-8 bg-gradient-to-r from-blue-400 to-sky-400 rounded-xl text-white text-lg font-semibold hover:bg-gradient-to-r hover:from-blue-500 hover:to-sky-500 shadow-lg hover:shadow-xl transition-all duration-200" %>
      <%= link_to t('.consume'), new_food_actions_consume_path,
          class: "py-4 px-8 sm:px-16 bg-gradient-to-r from-pink-400 to-rose-400 rounded-xl text-white text-lg font-semibold hover:bg-gradient-to-r hover:from-pink-500 hover:to-rose-500 shadow-lg hover:shadow-xl transition-all duration-200" %>
    </div>
  </div>

</main>
