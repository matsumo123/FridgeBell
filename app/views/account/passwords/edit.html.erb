<%= turbo_frame_tag "account_modal" do %>
  <div data-controller="account-modal" data-account-modal-target="passwordModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6">
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50">
      <div class="w-full max-w-md bg-white rounded-xl shadow-md p-6 relative">
        <div class="text-center relative">
          <div class="flex items-center justify-center gap-2 mb-4">
            <%= heroicon "key", options: { class: "w-5 h-5 text-gray-700" } %>
            <h1 class="text-xl md:text-2xl font-semibold tracking-tight text-gray-700 mb-4l">
              <%= t('.password_edit') %>
            </h1>
          </div>
          <button type="button"
            class="absolute right-0 top-0 inline-flex items-center justify-center rounded-full size-8 hover:bg-gray-100"
            data-action="click->account-modal#closePasswordModal">
            <%= heroicon "x-circle",  variant: :outline, options: { class: "w-10 h-10 text-gray-700"} %>
          </button>
        </div>

        <div class="mt-2 rounded-lg bg-white border border-gray-200 p-6 shadow-sm">
          <%= form_with(model: current_user, url: account_password_path, data: { action: "turbo:submit-end->account-modal#closePassword" }, html: { method: :put }) do |f| %>
          <%= render "devise/shared/error_messages", resource: current_user %>

            <div class="flex flex-col space-y-2">
              <%= f.label :current_password, class: "block text-left text-sm font-medium text-gray-700" %>
              <%= f.password_field :current_password, class: "w-full ml-2 mb-2 rounded-xl border-2 border-gray-400 bg-white/80 px-3 py-2 text-gray-800"%>
            </div>

            <div class="flex flex-col space-y-2 mt-2">
              <%= f.label :password, class: "block text-left text-sm font-medium text-gray-700" %>
              <%= f.password_field :password, class: "w-full ml-2 mb-2 rounded-xl border-2 border-gray-400 bg-white/80 px-3 py-2 text-gray-800", placeholder: t('.placeholders.password') %>
            </div>

            <div class="flex flex-col space-y-2 mt-2">
              <%= f.label :password_confirmation, class: "block text-left text-sm font-medium text-gray-700" %>
              <%= f.password_field :password_confirmation, class: "w-full ml-2 mb-2 rounded-xl border-2 border-gray-400 bg-white/80 px-3 py-2 text-gray-800", placeholder: t('.placeholders.password_confirmation') %>
            </div>

            <%= f.submit t('.update'), class: "w-full mt-4 bg-orange-400 hover:bg-orange-500 text-white font-semibold py-2 text-lg rounded-xl shadow-lg hover:shadow-xl transition-all duration-200" %>

            <button type="button" data-action="click->account-modal#closePasswordModal"
            class = "w-full inline-block text-center mt-2 bg-gray-200 hover:bg-gray-300 text-gray-600 font-semibold py-2 text-lg rounded-xl shadow-lg hover:shadow-xl transition-all duration-200">
              <%= t('.cancel') %>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
