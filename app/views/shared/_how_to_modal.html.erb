<div class="fixed inset-0 z-50 grid place-items-center p-4 sm:p-6 overflow-y-auto">
  <div data-action="click->how-to-modal#closeModal" class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 sm:p-6">

    <div class="relative w-full max-w-2xl bg-gradient-to-br from-orange-50 to-green-50 rounded-2xl shadow-lg pointer-events-auto overflow-hidden">
      <button type="button"
              class="absolute right-3 top-2 inline-flex items-center justify-center rounded-full size-8 hover:bg-gray-100"
              data-action="click->how-to-modal#closeModal">
        <%= heroicon "x-circle",  variant: :outline, options: { class: "w-10 h-10 text-gray-700"} %>
      </button>
    
      <div class="p-6 max-h-[min(80vh,calc(100vh-4rem))] overflow-y-auto">
        <%= render 'shared/how_to' %>
      </div>
    </div>

  </div>
</div>