<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  <div class="bg-white rounded-xl shadow p-4">
    <div class="flex items-center justify-center gap-2 mb-2">
      <div class="p-2 rounded-full bg-orange-100 border-2 border-orange-400 flex items-center justify-center">
        <%= heroicon "pencil-square", variant: :outline, options: { class: "w-6 h-6 text-orange-500" } %>
      </div>
      <h3 class="text-lg font-semibold text-gray-800">
        <%= t('.user_foods_new') %>
      </h3>
    </div>
    <p class="text-sm text-gray-600 text-center">
      <%= t('.user_foods_new_description1') %><br>
      <%= t('.user_foods_new_description2') %>
    </p>
  </div>

  <div class="bg-white rounded-xl shadow p-4">
    <div class="flex items-center justify-center gap-2 mb-2">
      <div class="p-2 rounded-full bg-green-100 border-2 border-green-400 flex items-center justify-center">
        <i class="material-symbols-rounded text-xl text-green-500">nutrition</i>
      </div>
      <h3 class="text-lg font-semibold text-gray-800">
        <%= t('.foods_new') %>
      </h3>
    </div>
    <p class="text-sm text-gray-600 text-center">
      <%= t('.foods_description') %>
    </p>
  </div>

  <div class="bg-white rounded-xl shadow p-4">
    <div class="flex items-center justify-center gap-2 mb-2">
      <div class="p-2 rounded-full bg-blue-100 border-2 border-blue-400 flex items-center justify-center">
        <i class="material-symbols-rounded text-xl text-blue-500">kitchen</i>
      </div>
      <h3 class="text-lg font-semibold text-gray-800">
        <%= t('.user_foods_index') %>
      </h3>
    </div>
    <p class="text-sm text-gray-600 text-center">
      <%= t('.user_foods_index_description1') %><br>
      <%= t('.user_foods_index_description2') %>
    </p>
  </div>

  <div class="bg-white rounded-xl shadow p-4">
    <div class="flex items-center justify-center gap-2 mb-2">
      <div class="p-2 rounded-full bg-pink-100 border-2 border-pink-400 flex items-center justify-center">
        <i class="material-symbols-rounded text-xl text-pink-500">fork_spoon</i>
      </div>
      <h3 class="text-lg font-semibold text-gray-800">
        <%= t('.consume_discard') %>
      </h3>
    </div>
    <p class="text-sm text-gray-600 text-center">
      <%= t('.consume_discard_description1') %><br>
      <%= t('.consume_discard_description2') %>
    </p>
  </div>

  <div class="bg-white rounded-xl shadow p-4">
    <div class="flex items-center justify-center gap-2 mb-2">
      <div class="p-2 rounded-full bg-violet-100 border-2 border-violet-400 flex items-center justify-center">
        <%= heroicon "bell-alert", variant: :outline, options: { class: "w-6 h-6 text-violet-500" } %>
      </div>
      <h3 class="text-lg font-semibold text-gray-500">
        <%= t('.remind') %>
      </h3>
    </div>
    <p class="text-sm text-gray-600 text-center">
      <%= t('.remind_description') %>
    </p>
  </div>
</div>
