<header class="sticky top-0 z-50 bg-orange-50">
  <div class="flex items-center justify-between shadow-sm border-b border-orange-100 px-4 sm:px-6 py-4 md:px-8">
    <div class="flex justify-start space-x-2">
      <%= image_tag 'FridgeBell_logo.png', class: "w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12" %>
      <%= link_to '/' do %>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-exo2 font-bold leading-tight overflow-visible bg-gradient-to-r from-orange-500 to-pink-500 bg-clip-text text-transparent md:text-3xl">
          <%= t('.app_name') %>
        </h1>
      <% end %>
    </div>
    <% if user_signed_in? %>
      <div  data-controller="how-to-modal" class="flex items-center gap-2 sm:gap-4 font-mono">
        <button data-action="click->how-to-modal#open" class= "flex items-center text-gray-700 hover:font-semibold">
          <%= heroicon "information-circle", variant: :outline, options: { class: "w-5 h-5 text-gray-600" } %>
          <span class="ml-1 text-sm font-medium text-gray-70">
            <%= t('.how_to') %>
          </span>
        </button>
        <div data-controller="user-menu" class="relative">
          <button data-action="click->user-menu#toggle" class="flex items-center text-gray-700 hover:font-semibold">
            <%= heroicon "user", options: { class: "w-4 h-4 text-gray-600" } %>
            <span class="ml-1 text-sm font-medium text-gray-70">
              <%= current_user.name %>
            </span>
          </button>
          <div data-user-menu-target="menu" class="absolute right-0 mt-2 w-48 rounded-md shadow-lg z-50 bg-gradient-to-br from-orange-50 to-green-50 border border-gray-500 hidden">
            <div class="py-1">
              <%= link_to t('.user_profile'), users_profile_path, class:"block px-4 py-2 text-sm text-gray-700 hover:bg-gray-200" %>
              <%= link_to t('.terms_of_service'), page_path('terms'), class:"block px-4 py-2 text-sm text-gray-700 hover:bg-gray-200" %>
              <%= link_to t('.privacy_policy'), page_path('policy'), class:"block px-4 py-2 text-sm text-gray-700 hover:bg-gray-200" %>
              <%= link_to t('.contact_us'), page_path('contact'), class:"block px-4 py-2 text-sm text-gray-700 hover:bg-gray-200" %>
              <%= link_to t('.logout'), destroy_user_session_path, data: { turbo_method: :delete}, class:"block px-4 py-2 text-sm text-red-700 hover:bg-gray-200" %>
            </div>
          </div>
        </div>
        <div data-how-to-modal-target="modal" class="hidden fixed inset-0 z-[60]">
          <%= render "shared/how_to_modal" %>
        </div>
      </div>
    <% else %>
      <div>
        <%= link_to t('.login'), new_user_session_path, class:"border border-orange-200 rounded px-4 py-2 text-orange-500 hover:bg-orange-100 hover:text-orange-600 font-mono" %>
      </div>
    <% end %>
  </div>
</header>
