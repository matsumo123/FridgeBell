<div class="px-4 py-4">
  <div class="mx-auto max-w-5xl">
    <div class="overflow-x-auto overflow-y-hidden">
      <ul class="flex gap-2 w-max mx-auto px-2 whitespace-nowrap">
        <li class="flex-shrink-0">
          <%= link_to favorites_foods_path,
            class: "inline-flex items-center px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 " + 
            "#{ current_page?(favorites_foods_path) ? "bg-orange-200 text-orange-700" : "bg-gray-100 text-gray-700 hover:bg-gray-200" }" do %>
            <%= heroicon "heart", options: { class: "w-4 h-4" + 
            "#{ current_page?(favorites_foods_path) ? "text-orange-700" : "text-gray-500" }" } %>
            お気に入り
          <% end %>
        </li>
        <% categories.each do |category| %>
          <li class="flex-shrink-0">
            <%= link_to category.name,
              new_user_food_path(category_id: category.id),
              class: "inline-flex items-center px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 " + 
              (params[:category_id].to_i == category.id ? "bg-orange-200 text-orange-700" : "bg-gray-100 text-gray-700 hover:bg-gray-200") %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
