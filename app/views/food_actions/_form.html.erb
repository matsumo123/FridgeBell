<%= form_with model: form, url: url, method: :post do |form| %>
  <%= render "shared/error_messages", object: form.object %>
  <div class="bg-white rounded-2xl shadow-md px-4 py-2 max-w-3xl mx-2 mb-2 ">
    <div class="py-2 text-center">
      <h1 class="sm:text-lg font-medium text-gray-900 leading-relaxed">
        <%= t('.title') %>
      </h1>
      <p class="text-xs sm:text-sm text-gray-600">
        <%= t('.follow_message') %>
      </p>
    </div>
    <% user_foods.each_with_index do |user_food, i| %>
      <% remaining_days = (user_food.deadline_date - Date.today).to_i %>
      <% fa = form.object.food_actions[i] %>
      <%= form.fields_for :food_actions, fa do |f| %>
        <%= f.hidden_field :action_type, value: object %>
        <%= f.hidden_field :user_food_id, value: user_food.id %>
        <%= f.hidden_field :action_date, value: Time.current %>
        <div class="relative flex items-start gap-4 rounded-2xl border border-gray-200 bg-white p-4 md:p-5 shadow-sm hover:shadow-md transition-shadow duration-200 mb-4 before:content-[''] before:absolute before:top-2 before:bottom-2 before:left-2 before:w-2.5 before:rounded-full <%= bg_color(remaining_days) %>">

          <div class="self-center ml-4">
            <%= f.check_box :availability, { class: "w-5 h-5" } %>
          </div>
        
          <div class="flex items-center flex-1">
            <div class="flex-shrink-0 w-30 h-30 md:w-40 md:h-40 bg-white flex items-center justify-center">
              <% if user_food.food.food_image.attached? %>
                <%= image_tag user_food.food.food_image.variant(resize_to_limit: [100, 100]) %>
              <% else %>
                <div class="flex-shrink-0 w-30 h-30 md:w-40 md:h-40 rounded-xl ring-1 ring-gray-200 bg-white flex items-center justify-center">
                  <p class="text-gray-700"><%= t('.no_image') %></P>
                </div>
              <% end %>
            </div>

            <div class="flex flex-col flex-1 ml-2 self-center text-sm leading-relaxed space-y-1.5">
              <div class="flex flex-col items-start gap-1 md:flex-row md:items-center md:gap-3">
                <div class="font-semibold text-base md:text-lg text-gray-900">
                  <%= user_food.food.name %>
                </div>
                <% if remaining_days < 0 %>
                  <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-red-800 ring-1 ring-inset ring-gray-200">
                    <%= emoji(remaining_days) %>
                    <%= t('.please_come_early') %>
                    <%= heroicon "exclamation-triangle", variant: :outline, options: { class: "w-5 h-5" } %>
                  </div>
                <% elsif remaining_days == 0 %>
                  <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-red-700 ring-1 ring-inset ring-gray-200">
                    <%= emoji(remaining_days) %>
                    <%= t('.today') %>
                  </div>
                <% else %>
                  <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-red-700 ring-1 ring-inset ring-gray-200">
                    <%= emoji(remaining_days) %>
                    <%= t('.how_many_days', deadline_days: remaining_days) %>
                  </div>
                <% end %>
              </div>

              <div class="text-sm text-gray-600">
                <%= t('.deadline') %>: <%= user_food.deadline_date %>
              </div>
              <div class="text-sm text-gray-600">
                <%= f.label :quantity %>:
                <%= f.number_field :quantity, value: (fa.quantity || user_food.quantity), max: user_food.quantity, min: user_food.food.quantity, step: user_food.food.quantity, class: "w-14 md:w-16 mx-1 border rounded px-2 py-1" %><%= user_food.food.unit %>
              </div>
              <% if user_food.mini_memo.present? %>
                <div class="text-sm text-gray-700">
                  <%= t('.mini_memo') %>: <%= user_food.mini_memo %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
    <div class="sticky bottom-[calc(90px+env(safe-area-inset-bottom))] z-40 mx-auto max-w-3xl px-4 pb-safe">
      <%= form.submit t('.registration'), class: "w-full px-4 py-4 rounded-xl bg-orange-500 text-white font-semibold hover:bg-orange-600 shadow" %>
    </div>
  </div>
<% end %>
