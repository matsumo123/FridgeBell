<div class="grid grid-cols-3 items-center mb-4 mx-2 sm:mx-6">
  <div class="justify-self-start">
    <%= link_to link1, data: data, class: "flex items-center gap-1 px-4 py-2 text-gray-700 border border-gray-400 rounded-2xl shadow-sm hover:bg-gray-100 hover:shadow transition-all duration-200 w-24 h-9 justify-center" do %>
      <%= heroicon "chevron-left", options: { class: "w-3 h-3 text-gray-500" } %>
      <span class="text-xs md:text-sm">先月</span>
    <% end %>
  </div>

  <div class="justify-self-center text-gray-800 font-semibold sm:text-xl">
    <%= @month.strftime("%Y/%m") %>
  </div>

  <div class="justify-self-end">
    <% unless @month.month == Time.current.month %>
      <%= link_to link2, data: data, class: "flex items-center gap-1 px-4 py-2 text-gray-700 border border-gray-400 rounded-2xl shadow-sm hover:bg-gray-100 hover:shadow transition-all duration-200 w-24 h-9 justify-center" do %>
        <%= heroicon "chevron-right", options: { class: "w-3 h-3 text-gray-500" } %>
        <span class="text-xs md:text-sm">翌月</span>
      <% end %>
    <% else %>
      <div class="w-24 h-9"></div>
    <% end %>
  </div>
</div>
