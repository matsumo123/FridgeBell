<% content_for(:title, t('.title')) %>
<main class="flex-1 md:px-6">
  <div class="mx-auto max-w-lg md:max-w-2xl space-y-4 font-mono">
    <div class="text-center">
      <h1 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-gray-600">
        <%= t('.semi_title') %>
      </h1>
    </div>
    <%= render 'food_actions/form', form: @form, user_foods: @user_foods, url: food_actions_discard_path, object: "discarded" %>
  </div>
</main>
