<%= turbo_frame_tag "account_modal" do %>
  <div data-controller="account-modal" data-account-modal-target="userModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6">
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50">
      <div class="w-full max-w-md bg-white rounded-xl shadow-md p-6 relative font-mono">
        <div class="text-center relative">
          <div class="flex items-center justify-center gap-2 mb-4">
            <%= heroicon "user", options: { class: "w-5 h-5 text-gray-700" } %>
            <h1 class="text-xl md:text-2xl font-semibold tracking-tight text-gray-700 mb-4l">
              <%= t('.user_profile_edit') %>
            </h1>
          </div>
          <button type="button"
            class="absolute right-0 top-0 inline-flex items-center justify-center rounded-full size-8 hover:bg-gray-100"
            data-action="click->account-modal#closeUserModal">
            <%= heroicon "x-circle",  variant: :outline, options: { class: "w-10 h-10 text-gray-700"} %>
          </button>
        </div>

        <div class="mt-2 rounded-lg bg-white border border-gray-200 py-4 px-8 shadow-sm">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { action: "turbo:submit-end->account-modal#closeUser" }, html: { method: :put }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="flex flex-col space-y-1">
            <%= f.label :name, class: "block text-left text-sm font-medium text-gray-700" %>
            <%= f.text_field :name, class: "w-full ml-2 mb-2 rounded-lg border border-gray-400 px-4 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-300 focus:border-gray-300 focus:ring-offset-2 focus:ring-offset-white"%>
          </div>

          <div class="flex flex-col space-y-1">
            <%= f.label :email, class: "block text-left text-sm font-medium text-gray-700" %>
            <%= f.email_field :email, class: "w-full ml-2 mb-2 rounded-lg border border-gray-400 px-4 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-300 focus:border-gray-300 focus:ring-offset-2 focus:ring-offset-white" %>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %>  </div>
          <% end %>

          <%= f.submit t('.update'), class: "w-full mt-2 px-4 py-2 rounded-xl bg-orange-500 text-sm text-white font-semibold hover:bg-orange-600 shadow" %>
        
          <button type="button" data-action="click->account-modal#closeUserModal"
            class= "w-full inline-block text-sm text-center mt-2 px-4 py-2 rounded-xl border hover:bg-gray-50">
              <%= t('.cancel') %>
          </button>
        <% end %>
      </div>
      </div>
    </div>
  </div>
<% end %>
