<%= turbo_frame_tag "foods_modal" do %>
  <div data-controller="foods-modal" data-foods-modal-target="foodModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50">
    <div class="w-full max-w-md bg-white rounded-xl shadow-md py-4 px-8 relative font-mono max-h-[85vh] overflow-y-auto">
      <div class="text-center">
        <h1 class="text-xl md:text-2xl font-semibold tracking-tight text-gray-700 mb-2">
          <%= t('.title') %>
        </h1>
        <button type="button"
          class="absolute right-5 top-3 inline-flex items-center justify-center rounded-full size-8 hover:bg-gray-100"
          data-action="click->foods-modal#closeModal">
          <%= heroicon "x-circle",  variant: :outline, options: { class: "w-10 h-10 text-gray-700"} %>
        </button>
      </div>

      <div class="rounded-lg bg-white border border-gray-200 py-4 px-8 shadow-sm">
        <%= render 'form', food: @food %>
        <div class="space-y-2">
          <%= link_to t('.back'), user_foods_path(category_id: params[:category_id]), data: { action: "click->foods-modal#closeModal" }, class: "w-full inline-block text-center mt-2 px-4 py-2 rounded-xl border hover:bg-gray-50" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
