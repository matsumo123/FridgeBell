<main class="flex-1 md:px-8">
  <div class="mx-auto max-w-xl md:max-w-7xl space-y-6">
    <div class="min-h-screen flex justify-center items-start mb-4 mx-2">
      <div class="bg-white shadow-sm border border-gray-100 rounded-2xl w-full max-w-6xl font-mono">
        <div class="my-4 text-center">
          <h1 class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-amber-600">
              冷蔵庫に追加する食材を選択しよう
          </h1>
        </div>
    
        <div class="sm:py-2 text-center">
          <h1 class="sm:text-lg font-medium text-gray-900 leading-relaxed">
            step1: 食材の数量を設定してください
          </h1>
          <p class="text-xs md:text-sm text-gray-600 mt-2">
            ページをまたいだ一括登録はできません。1ページ以内なら複数まとめて登録できます。
          </p>
        </div>

        <div class="border-b border-gray-100">
          <%= render 'categories/category_nav', categories: @categories %>
        </div>

        <% if @favorite_foods.present? %>
          <div class="mx-4">
            <%= render "new_form", foods: @favorite_foods, user_food: @user_food %>
          </div>
        <% else %>
          <div class="flex justify-center mt-4">
            <span class="text-sm text-gray-700">お気に入り登録している食材はありません</span>
          </div>
        <% end %>

        <div class="flex justify-center my-4">
          <%= link_to new_food_path(category_id: params[:category_id]),
            data: { turbo_frame: 'foods_modal' },
            class: "flex items-center gap-2 px-6 py-3 bg-white rounded-xl border-1 border-gray-200 shadow-sm hover:shadow-md transition text-gray-700 font-medium" do %>
            <%= heroicon "plus", options: { class: "w-10 h-10 text-gray-800" } %>
            食材追加  
          <% end %>
        </div>
      </div>
    </div>
  </div>
</main>
