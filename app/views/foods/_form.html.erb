<%= form_with(model: food, html: { data: { turbo_frame: 'foods', action: "turbo:submit-end->foods-modal#closeIfSuccess" } }) do |f| %>
<%= render "shared/error_messages", object: f.object %>
  <div class="flex flex-col items-center space-y-2">
    <div class="flex justify-center">
      <div class="w-24 h-24 border-1 border-gray-300 rounded-lg flex items-center justify-center bg-gray-100">
        <span class="text-xs text-gray-500 text-center px-2">
          画像なし
        </span>
      </div>
    </div>
    <div class="w-full max-w-sm space-y-4">
      <div>
        <div class="flex items-center">
          <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
          <span class="text-red-500 text-xs ml-1">
            <%= t('.required') %>
          </span>
        </div>
        <%= f.text_field :name, class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-300"%>
      </div>

      <div>
        <div class="flex items-center">
          <%= f.label :quantity, class: "block text-sm font-medium text-gray-700" %>
          <span class="text-red-500 text-xs ml-1">
            <%= t('.required') %>
          </span>
        </div>
        <%= f.number_field :quantity, min: 1, class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-300", placeholder: "例）1 , 1/2 , 1/4" %>
      </div>

      <div>
        <div class="flex items-center">
          <%= f.label :unit, class: "block text-sm font-medium text-gray-700" %>
          <span class="text-red-500 text-xs ml-1">
            <%= t('.required') %>
          </span>
        </div>
        <%= f.text_field :unit, class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-300", placeholder: "例）個 , 本 , パック" %>
      </div>

      <div>
        <%= f.label :default_deadline, class: "block text-sm font-medium text-gray-700" %>
        <%= f.number_field :default_deadline, min: 1, class: "mt-1 w-1/3 px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-300", placeholder: "例）7" %>
        <span class="text-lg font-medium text-gray-700">
          <%= t('.day') %>
        </span>
        <p class="text-sm text-muted-foreground text-gray-700">
          設定しない場合はカテゴリーが肉, 魚介･海藻の場合は2日、
          それ以外は7日で設定されます。 
        </p>
      </div>

      <%= f.hidden_field :category_id %>
    </div>
  </div>
  <%= f.submit nil, class: "w-full px-4 py-2 rounded-xl bg-orange-500 text-white font-semibold hover:bg-orange-600 shadow" %> 
<% end %>
