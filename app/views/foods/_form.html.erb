<%= form_with(model: food, html: { data: { turbo_frame: 'foods', action: "turbo:submit-end->foods-modal#closeIfSuccess" } }) do |f| %>
<%= render "shared/error_messages", object: f.object %>
  <div class="flex flex-col items-center space-y-2 font-mono">
    <div class="flex justify-center">
      <div class="w-24 h-24 border-1 border-gray-300 rounded-lg flex items-center justify-center bg-gray-100">
        <span class="text-xs text-gray-500 text-center px-2">
          <%= t('.no_image') %>
        </span>
      </div>
    </div>
    <div class="w-full max-w-sm space-y-4">
      <div>
        <div class="flex items-center mb-1">
          <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
          <span class="text-red-500 text-xs ml-1">
            <%= t('.required') %>
          </span>
        </div>
        <%= f.text_field :name, class: "w-full rounded-lg border border-gray-400 px-4 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-300 focus:border-gray-300 focus:ring-offset-2 focus:ring-offset-white"%>
      </div>

      <div>
        <div class="flex items-center mb-1">
          <%= f.label :quantity, class: "block text-sm font-medium text-gray-700" %>
          <span class="text-red-500 text-xs ml-1">
            <%= t('.required') %>
          </span>
        </div>
        <%= f.number_field :quantity, min: 0.25, step: 0.25,class: "w-full rounded-lg border border-gray-400 px-4 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-300 focus:border-gray-300 focus:ring-offset-2 focus:ring-offset-white", placeholder: t('.placeholders.quantity') %>
      </div>

      <div>
        <div class="flex items-center mb-1">
          <%= f.label :unit, class: "block text-sm font-medium text-gray-700" %>
          <span class="text-red-500 text-xs ml-1">
            <%= t('.required') %>
          </span>
        </div>
        <%= f.text_field :unit, class: "w-full rounded-lg border border-gray-400 px-4 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-300 focus:border-gray-300 focus:ring-offset-2 focus:ring-offset-white", placeholder: t('.placeholders.unit') %>
      </div>

      <div>
        <%= f.label :default_deadline, class: "block text-sm font-medium text-gray-700" %>
        <%= f.number_field :default_deadline, min: 1, class: "mt-1 w-1/3 rounded-lg border border-gray-400 px-4 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-300 focus:border-gray-300 focus:ring-offset-2 focus:ring-offset-white", placeholder: t('.placeholders.deadline') %>
        <span class="text-lg font-medium text-gray-700">
          <%= t('.day') %>
        </span>
        <p class="text-xs text-muted-foreground text-gray-700 mt-1">
          <%= t('.deadline_description') %> 
        </p>
      </div>

      <%= f.hidden_field :category_id %>
    </div>
  </div>
  <%= f.submit nil, class: "w-full px-4 py-2 rounded-xl bg-orange-500 text-white font-semibold hover:bg-orange-600 shadow" %> 
<% end %>
