<div data-controller="previews">
  <%= f.label :food_image, class: "block text-sm font-medium text-gray-700" %>
  <%= f.file_field :food_image,
    class: "file-input file-input-sm",
    data: { previews_target: "input", action: "change->previews#preview" } %>

  <% if food.food_image.attached? %>
    <div class="flex justify-center mt-2">
      <%= image_tag food.food_image, data: { previews_target: "preview" } %>
    </div>
  <% else %>
    <div class="flex justify-center mt-2">
      <div class="w-24 h-24 border-1 border-gray-300 rounded-lg flex items-center justify-center bg-gray-100">
        <span class="text-xs text-gray-500 text-center px-2">
          <%= t('.no_image') %>
        </span>
      </div>
    </div>
  <% end %>  
</div>
