<% @foods.each do |food| %>
  <div class="bg-white">
    <li class="flex w-full items-center rounded-md text-sm text-gray-800 py-2 px-3 hover:bg-amber-200" role="option" data-autocomplete-value="<%= food.id %>" data-autocomplete-label="<%= food.name %>">
      <%= food.name %>
    </li>
  </div>
<% end %>
