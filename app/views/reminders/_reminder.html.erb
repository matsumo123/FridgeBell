<%= turbo_frame_tag "reminder" do %>
  <% if reminder.present? %>
    <div>
      <p class="mt-4 mb-1 text-xs font-semibold tracking-wider text-gray-500">
        リマインド
      </p>
      <div class="flex items-baseline gap-2">
        <span class="text-base text-gray-800">期限の</span>
        <span class="inline-flex items-center justify-center text-base md:text-lg font-bold tabular-nums"><%= reminder.days_before %></span>
        <span class="text-base md:text-base text-gray-800">日前に通知</span>
    </div>

    <div>
      <p class="mt-6 mb-1 text-xs font-semibold tracking-wider text-gray-500">
        通知時刻
      </p>
      <div class="text-base md:text-lg font-medium text-gray-800 tabular-nums">
        <%= reminder.remind_time.strftime("%-H時%M分") %>
      </div>
    </div>

    <div class="flex justify-end">
      <%= link_to edit_reminder_path, data: { turbo_frame: 'reminder_modal' }, class: "inline-flex items-center justify-center rounded-full py-2 px-4 text-gray-600 bg-gray-100 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-300  mr-4" do %>
        <%= heroicon "pencil", variant: :outline, options: { class: "w-5 h-5 mr-1"} %>
        編集
      <% end %>
      <%= link_to reminder_path, data: { turbo_method: :delete, turbo_confirm: t('helpers.turbo_confirm.delete') }, class: "inline-flex items-center justify-center rounded-full py-2 px-4 text-gray-600 bg-gray-100 hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-300" do %>
        <%= heroicon "trash", variant: :outline, options: { class: "w-5 h-5 mr-1"} %>
        削除
      <% end %>
    </div>
  <% else %>
    <div class="mt-4 mb-1 text-xs font-semibold text-gray-700 text-center">
      <p class="block">食材の期限が切れる前に通知を受け取ろう！</p>
      <%= link_to "リマインドを設定する", new_reminder_path, data: { turbo_frame: 'reminder_modal' }, class: "inline-flex items-center mt-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-orange-400 to-pink-400 text-white font-semibold shadow-sm hover:shadow-md hover:from-orange-500 hover:to-pink-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-300 transition" %>
    </div>
  <% end %>
<% end %>
