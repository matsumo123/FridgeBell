<main class="flex-1 px-4 md:px-8">
  <div class="mx-auto max-w-md space-y-4 py-2">
    <div class="text-center">
      <h1 class="text-3xl font-extrabold bg-gradient-to-r from-orange-500 to-pink-500 bg-clip-text text-transparent drop-shadow-sm  md:text-4xl">
        <%= t('.my_page') %>
      </h1>
    </div>

    <div class="rounded-3xl bg-white shadow-xl border border-orange-100 overflow-hidden">
      <div class="p-8 space-y-5">
        <div class="text-center space-y-3">
          <div class="w-20 h-20 bg-gradient-to-br from-orange-300 to-green-300 rounded-full mx-auto flex items-center justify-center shadow-md">
            <span class="text-3xl">
              <%= heroicon "user", options: { class: "w-8 h-8 text-white" } %>
            </span>
          </div>
          <h2 class="text-xl font-bold text-gray-800 relative mx-auto w-fit px-6 whitespace-nowrap">
            <%= current_user.name %>
            <%= link_to edit_user_registration_path, class: "absolute right-0 top-1/2 -translate-y-1/2 inline-flex p-1 rounded-full hover:bg-gray-100", data: { turbo_frame: 'account_modal' } do %>
              <%= heroicon "pencil", options: { class: "w-5 h-5 text-gray-700"} %>
            <% end %>
          </h2>
          <p class="text-gray-500 text-sm">
            <%= current_user.email %>
          </p>
        </div>
      </div>
    </div>

    <div class="mt-4">
      <%= link_to edit_account_password_path, class:"w-full bg-gradient-to-r from-lime-400 to-green-500 hover:from-lime-500 hover:to-green-600 text-white font-semibold py-3 text-lg rounded-2xl shadow-md active:scale-95 transition-all flex items-center justify-center gap-2", data: { turbo_frame: 'account_modal' } do %>
        <%= t('.password_edit') %>
      <% end %>
    </div>

    <div class="text-center">
      <%= link_to destroy_user_session_path, data: { turbo_method: :delete}, class:"inline-block font-semibold rounded-full py-2 w-full text-red-600 bg-red-50 transition-colors" do %>
        <%= t('.logout') %>
      <% end %>
    </div>
  </div>
</main>
