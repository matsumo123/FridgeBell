<% content_for(:title, t('.title')) %>
<main class="flex-1 md:px-6">
  <div class="mx-auto max-w-lg md:max-w-2xl space-y-4 font-mono">
    <div class="border-b border-gray-100 px-4 pb-2 flex flex-col items-center gap-1">
      <h1 class="text-center text-xl md:text-2xl font-semibold text-gray-700 tracking-tight">
        <%= t('.semi_title') %>
      </h1>
    </div>
    <!-- タブ -->
    <%= turbo_frame_tag "tab_content" do %>
    <div class="tabs tabs-bordered flex justify-center mb-4">
      <ul class="tab">
        <li>
          <%= link_to t('.all'), user_foods_path(tab: "all"), data: { turbo_frame: "tab_content" }, class: "tab #{ @current_tab == 'all' ? 'tab-active font-bold border-b-4 border-orange-400 text-gray-800' : '' }" %>
        </li>
        <li>
          <%= link_to t('.expired'), user_foods_path(tab: "expired"), data: { turbo_frame: "tab_content" }, class: "tab #{ @current_tab == 'expired' ? 'tab-active font-bold border-b-4 border-orange-400 text-gray-800' : '' }" %>
        </li>
        <li>
          <%= link_to t('.two_days_ago'), user_foods_path(tab: "two_days"), data: { turbo_frame: "tab_content" }, class: "tab #{ @current_tab == 'two_days' ? 'tab-active font-bold border-b-4 border-orange-400 text-gray-800' : '' }"  %>
        </li>
        <li>
          <%= link_to t('.five_days_ago'), user_foods_path(tab: "five_days"), data: { turbo_frame: "tab_content" }, class: "tab #{ @current_tab == 'five_days' ? 'tab-active font-bold border-b-4 border-orange-400 text-gray-800' : '' }" %>
        </li>
      </ul>
    </div>

      <div class="px-4 py-2">
        <% if @user_foods.blank? && @current_tab == "all" %>
          <span class="block text-center text-gray-600 md:text-xl font-semibold tracking-tight">
            <%= t('.fridge_blank') %>
          </span>
          <div class="mt-3 flex justify-center items-center gap-2">
            <span class="text-gray-600 font-semibold text-sm">
              <%= t('.let_us') %>
            </span>
            <%= link_to new_user_food_path(category_id: 1), class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-orange-400 to-pink-400 text-white font-semibold shadow-sm hover:shadow-md hover:from-orange-500 hover:to-pink-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-300 transition" do %>
              <%= heroicon "plus", options: { class: "w-5 h-5 text-white" } %>
              <%= t('.user_foods_new') %>
            <% end %>
            <span class="text-gray-600 font-semibold text-sm">
              <%= t('.try') %>🍴
            </span>
          </div>
        <% elsif @user_foods.blank? %>
          <%= render "no_results" %>
        <% else %>
          <% @user_foods.each do |user_food| %>
            <%= render partial: "user_food", locals: { user_food: user_food } %>
          <% end %>
          <%= paginate @user_foods, param_name: @current_tab + "_page", params: { tab: @current_tab } %>
        <% end %>
      </div>
    <% end %>

  </div>
</main>
