<%= turbo_frame_tag "user_food_modal" do %>
  <div data-controller="user-food-modal" data-user-food-modal-target="userFoodModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-5">
    <div class="bg-white mx-2 p-6 rounded-xl shadow-md w-full md:max-w-xl max-w-md relative">
      <button type="button"
              class="absolute right-4 top-4 inline-flex items-center justify-center rounded-full size-8 hover:bg-gray-100"
              data-action="click->user-food-modal#closeModal" aria-label="閉じる"><%= heroicon "x-circle",  variant: :outline, options: { class: "w-10 h-10 text-gray-700"} %>
      </button>
      <div class="text-center">
        <h1 class="text-xl md:text-2xl font-semibold tracking-tight text-gray-700 mb-4">
        冷蔵庫内の食材を修正
        </h1>
      </div>

      <div class="mt-2 rounded-lg bg-white border border-gray-200 p-6 shadow-sm">
        <%= form_with(model: @user_food, data: { action: "turbo:submit-end->user-food-modal#close" }) do |f| %>
        <%= render "shared/error_messages", object: f.object %>
          <div class="flex items-center justify-center gap-4 mb-6">
            <% if @user_food.food.food_image.attached? %>
              <%= image_tag @user_food.food.food_image.variant(resize_to_limit: [100, 100]) %>
            <% else %>
              <div class="flex-shrink-0 ml-2 w-30 h-30 md:w-40 md:h-40 rounded-xl overflow-hidden ring-1 ring-gray-200 bg-gray-100 flex items-center justify-center">
                <p class="text-gray-700">画像なし</P>
              </div>
            <% end %>
            <div>
              <h3 class="text-lg font-medium text-gray-900"><%= @user_food.food.name %></h3>
              <p class="text-sm test-gray-500">
                カテゴリー: <%= Category.find(@user_food.food.category_id).name %>
              </p>
            </div>
          </div>

          <div class="space-y-2 text-sm">
            <div class="flex flex-wrap md:flex-nowrap gap-4 items-start">
              <div class="w-20">
                <%= f.label :quantity, class: "block font-medium text-gray-700 mb-1" %>
                <%= f.number_field :quantity, min: 1, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm" %>
              </div>
              <div class="flex-1">
                <%= f.label :deadline_date, class: "block font-medium text-gray-700 mb-1" %>
                <div class="flex">
                  <div class="px-2 py-2 text-sm border border-gray-300 rounded-md shadow-sm">
                    <%= f.date_select :deadline_date,  { start_year: Date.today.year, end_year: Date.today.year + 5, use_month_numbers: true } %>
                  </div>
                </div>
              </div>
            </div>
            <div>
              <%= f.label :mini_memo, class: "block font-medium text-gray-700 mb-1" %>
              <%= f.text_area :mini_memo, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm" %>
              <div class="text-right text-xs text-gray-500 mt-1">
                <%= @user_food.mini_memo.length %>/50
              </div>
            </div>
          </div>
          <div class="flex justify-between mt-6 gap-3">
            <%= link_to "キャンセル", user_foods_path, class: "flex-1 text-center px-4 py-2 rounded-xl border hover:bg-gray-50", data: { action:"click->user-food-modal#closeModal" } %>
            <%= f.submit "更新", class: "flex-1 text-center px-4 py-2 rounded-xl bg-orange-500 text-white font-semibold hover:bg-orange-600 shadow" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
