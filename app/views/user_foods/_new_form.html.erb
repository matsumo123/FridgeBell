<%= turbo_frame_tag "foods", id: "foods" do %>
  <%= render "shared/flash_message" %>
  <div data-controller="foods-selection">
    <%= form_with model: @form, url: user_foods_path, html: { class: "mx-auto max-w-7xl grid gap-6 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4" } do |form| %>
    <%= render "shared/error_messages", object: form.object %>

      <% foods.each_with_index do |food, i| %>
        <div class="flex flex-col items-stretch gap-3 rounded-2xl bg-white shadow-sm ring-1 ring-gray-100 p-4">
          <%# ユーザーが食材リストに追加した食材の場合、食材の編集ができる %>
          <%# ユーザーが追加した食材リストの画像は指定 %>
          <% if food.user_id == current_user.id %>
            <div class="text-center text-lg space-x-2 font-semibold text-gray-800 px-1">
              <%= link_to edit_food_path(id: food.id), data: { turbo_frame: 'foods_modal' }, class: "inline-flex items-center space-x-1" do %>
                <%= food.name %>
                <%= heroicon "pencil", options: { class: "w-4 h-4 text-gray-700"} %>
              <% end %>
            </div>
            <div class="bg-gray-100 h-48 w-full rounded-xl flex items-center justify-center ring-1 ring-gray-200">
              <p><%= t('.no_image') %></p>
            </div>
          <% else %>
            <%# デフォルトの食材を表示 %>
            <div class="text-center text-lg font-semibold text-gray-800 px-1">
              <%= food.name %>
            </div>
            <div class="bg-gray-100 h-48 w-full rounded-xl flex items-center justify-center ring-1 ring-gray-200">
              <% if food.food_image.attached? %>
                <%= image_tag food.food_image.variant(resize_to_limit: [150, 150]) %>
              <% else %>
                <span class="text-xs text-gray-400"><%= t('.no_image') %></span>
              <% end %>
            </div>
          <% end %>

          <%# 冷蔵庫に登録する食材の数量を入力 %>
          <% fa = form.object.user_foods[i] %>
          <%= form.fields_for(:user_foods, fa, child_index: i) do |f| %>
            <%= f.hidden_field :food_id, value: food.id %>

            <div class="flex flex-col items-center gap-2">

              <div data-controller="counter" class="flex items-center  gap-2">
                <button data-action="click->counter#subtraction" type="button" class="border border-gray-300 rounded-lg text-gray-700 p-2 hover:border-2 hover:border-blue-400 hover:text-blue-400">
                  <%= heroicon "minus", options: { class: "w-10 h-10 sm:w-5 sm:h-5"} %>
                </button>

                <%= f.number_field :quantity, min: 0, step: 1, data: { foods_selection_target: "quantity", counter_target: "output", index: i, action: "input->foods-selection#check" }, class: "w-20 sm:w-16 text-center border border-gray-300 rounded-lg px-3 py-4 sm:py-2 shadow-inner" %>

                <button data-action="click->counter#addition" type="button" class="border border-gray-300 rounded-lg text-gray-700 p-2 hover:border-2 hover:border-red-400 hover:text-red-400">
                  <%= heroicon "plus", options: { class: "w-10 h-10 sm:w-5 sm:h-5"} %>
                </button>
                <span class="text-sm text-gray-600"><%= food.unit %></span>
              </div>
            </div>

          <% end %>
        </div>
      <% end %>
      
      <div class="col-span-full sticky bottom-[calc(64px+env(safe-area-inset-bottom))] z-40">
        <button
          data-action="click->foods-selection#open"
          data-foods-selection-target="nextButton"
          type="button"
          class="w-full py-4 px-6 bg-orange-500 text-white font-medium rounded-2xl shadow-lg transition-all duration-200 disabled:bg-gray-300 disabled:cursor-not-allowed enabled:hover:bg-orange-600 enabled:active:scale-98 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2"  disabled>
          <%= t('.next') %>
        </button>
      </div>

      <%= render 'details', form: form, foods: @foods, class: "hidden" %>
    <% end %>
  </div>
<% end %>
